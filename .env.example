# /opt/link/.env on the host, or .env.local in development.
LINK_VERSION=latest
# Where the web port binds; put a reverse proxy with TLS in front.
LINK_BIND=127.0.0.1:3000

# Pooled Postgres URL that holds the links.
DATABASE_URL=

# Traces and logs to Sensorium (OTLP/JSON). Leave the endpoint empty to send
# nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=link
